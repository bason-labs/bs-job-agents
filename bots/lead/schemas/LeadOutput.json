{
  "title": "LeadOutput",
  "type": "object",
  "properties": {
    "reply": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "start_workflow"
                ]
              },
              "workflow": {
                "type": "string",
                "description": "A shipped workflow (job-scan, apply-to-link, apply-to-file) or a saved preset's name"
              },
              "runId": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Run id returned by start_workflow"
              },
              "summary": {
                "type": "string",
                "description": "One line for the delegation trace"
              }
            },
            "required": [
              "type",
              "workflow",
              "runId",
              "summary"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "create_task"
                ]
              },
              "bot": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "taskId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "summary": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "bot",
              "kind",
              "taskId",
              "summary"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "ask_user"
                ]
              },
              "question": {
                "type": "string",
                "description": "One clarifying question (UC-01 a)"
              },
              "choices": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Suggested answers shown as chips; empty for free text"
              }
            },
            "required": [
              "type",
              "question",
              "choices"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "propose_workflow"
                ]
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "name",
              "description"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "answer_from_data"
                ]
              },
              "source": {
                "type": "string",
                "description": "What stored data answered the question, e.g. 'applications'"
              }
            },
            "required": [
              "type",
              "source"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "propose_criteria_change"
                ]
              },
              "changes": {
                "type": "object",
                "properties": {
                  "roles": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "add": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "remove": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "add",
                          "remove"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "null leaves this list as it is"
                  },
                  "locations": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "add": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "remove": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "add",
                          "remove"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "null leaves this list as it is"
                  },
                  "includeKeywords": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "add": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "remove": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "add",
                          "remove"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "null leaves this list as it is"
                  },
                  "excludeKeywords": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "add": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "remove": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "add",
                          "remove"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "null leaves this list as it is"
                  },
                  "excludeCompanies": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "add": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "remove": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "add",
                          "remove"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "null leaves this list as it is"
                  },
                  "companyTypes": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "add": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "remove": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "add",
                          "remove"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "null leaves this list as it is"
                  },
                  "workModes": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "onsite",
                            "hybrid",
                            "remote"
                          ]
                        }
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The new full list; null = unchanged"
                  },
                  "seniority": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "intern",
                            "junior",
                            "mid",
                            "senior",
                            "lead"
                          ]
                        }
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The new full list; null = unchanged"
                  },
                  "sources": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "topcv",
                            "itviec",
                            "linkedin",
                            "vietnamworks",
                            "remoteok",
                            "weworkremotely",
                            "remotive",
                            "jobspresso",
                            "wellfound",
                            "upwork"
                          ]
                        }
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The new full list; null = unchanged"
                  },
                  "minSalary": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "amount": {
                            "anyOf": [
                              {
                                "type": "integer",
                                "minimum": 0
                              },
                              {
                                "type": "null"
                              }
                            ],
                            "description": "null removes the floor"
                          },
                          "currency": {
                            "anyOf": [
                              {
                                "type": "string",
                                "enum": [
                                  "VND",
                                  "USD"
                                ]
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "amount",
                          "currency"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "null = unchanged"
                  },
                  "maxJobs": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 50
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "fitThreshold": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "roles",
                  "locations",
                  "includeKeywords",
                  "excludeKeywords",
                  "excludeCompanies",
                  "companyTypes",
                  "workModes",
                  "seniority",
                  "sources",
                  "minSalary",
                  "maxJobs",
                  "fitThreshold"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "changes"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "propose_schedule"
                ]
              },
              "schedule": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Short schedule name, e.g. Weekday morning scan"
                  },
                  "repeat": {
                    "type": "string",
                    "enum": [
                      "weekdays",
                      "daily",
                      "weekly"
                    ]
                  },
                  "day": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "Sun",
                          "Mon",
                          "Tue",
                          "Wed",
                          "Thu",
                          "Fri",
                          "Sat"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Day of the week for weekly; null otherwise"
                  },
                  "time": {
                    "type": "string",
                    "description": "HH:MM, 24-hour, Asia/Ho_Chi_Minh"
                  },
                  "searchProfileId": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "null = Ba's active search criteria"
                  }
                },
                "required": [
                  "name",
                  "repeat",
                  "day",
                  "time",
                  "searchProfileId"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "schedule"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "selfCheck": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "description": "The checklist item, copied from bot.json selfCheck"
          },
          "passed": {
            "type": "boolean"
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why it passed or failed; null when nothing to add"
          }
        },
        "required": [
          "item",
          "passed",
          "note"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "description": "One entry per selfCheck item in bot.json. Any failed item fails the attempt."
    },
    "memoryNotes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 3,
      "description": "Up to 3 short lessons for this bot's memory, e.g. 'TopCV upload limit is 5MB'. Empty if none."
    }
  },
  "required": [
    "reply",
    "actions",
    "selfCheck",
    "memoryNotes"
  ],
  "additionalProperties": false
}
