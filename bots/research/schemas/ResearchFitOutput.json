{
  "title": "ResearchFitOutput",
  "type": "object",
  "properties": {
    "fit": {
      "type": "object",
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Why it fits"
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "What the JD asks for that master data lacks"
        }
      },
      "required": [
        "score",
        "reasons",
        "gaps"
      ],
      "additionalProperties": false
    },
    "selfCheck": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "description": "The checklist item, copied from bot.json selfCheck"
          },
          "passed": {
            "type": "boolean"
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why it passed or failed; null when nothing to add"
          }
        },
        "required": [
          "item",
          "passed",
          "note"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "description": "One entry per selfCheck item in bot.json. Any failed item fails the attempt."
    },
    "memoryNotes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 3,
      "description": "Up to 3 short lessons for this bot's memory, e.g. 'TopCV upload limit is 5MB'. Empty if none."
    }
  },
  "required": [
    "fit",
    "selfCheck",
    "memoryNotes"
  ],
  "additionalProperties": false
}
