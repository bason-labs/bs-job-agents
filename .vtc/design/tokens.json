{
  "$description": "bs-job-agents design tokens (DTCG). Inherited from apps/web/app/globals.css (Deep Sea palette, light default, data-theme=dark). Only the groups marked NEW are added by this change; nothing inherited is changed.",
  "color": {
    "$type": "color",
    "light": {
      "bg": { "$value": "#f7f8fa", "$description": "page" },
      "surface": { "$value": "#ffffff", "$description": "cards, inputs" },
      "surface-2": { "$value": "#f1f4f8", "$description": "hover, inset" },
      "surface-3": { "$value": "#e8edf3", "$description": "deeper inset, code and diff ground" },
      "border": { "$value": "#e3e7ec" },
      "border-strong": { "$value": "#64748b", "$description": "NEW. Borders of controls that need 3:1 against surface (toggle chips, inputs). Equals muted." },
      "fg": { "$value": "#0f172a" },
      "muted": { "$value": "#64748b", "$description": "4.8:1 on surface; use only on surface or bg, never on surface-2 for text under 16px" },
      "brand": { "$value": "#006d6f" },
      "brand-2": { "$value": "#008b8b" },
      "glow": { "$value": "#0d98ba" },
      "accent": { "$value": "#15a3c7", "$description": "3.0:1 on surface: icons, borders and fills only, never small text" },
      "danger": { "$value": "#c92d3a" },
      "ok": { "$value": "#1a7f37" },
      "warn": { "$value": "#b7791f", "$description": "3.6:1 on surface: icons, borders and fills only, never text" },
      "on-brand": { "$value": "#ffffff" }
    },
    "dark": {
      "bg": { "$value": "#06100f" },
      "surface": { "$value": "#0e1c1c" },
      "surface-2": { "$value": "#152a2a" },
      "surface-3": { "$value": "#1a3535" },
      "border": { "$value": "#1f3a3a" },
      "border-strong": { "$value": "#7aa8a8", "$description": "NEW. Equals muted." },
      "fg": { "$value": "#e0ffff" },
      "muted": { "$value": "#7aa8a8" },
      "brand": { "$value": "#008b8b" },
      "brand-2": { "$value": "#006d6f" },
      "glow": { "$value": "#7df9ff" },
      "accent": { "$value": "#40e0d0" },
      "danger": { "$value": "#ff5f6d" },
      "ok": { "$value": "#3fd68a" },
      "warn": { "$value": "#f2c14e" },
      "on-brand": { "$value": "#ffffff" }
    },
    "grayscale": {
      "$description": "NEW. Wireframe theme: theme=grayscale. Every hue collapses to a grey; meaning is carried by icon and text, which is the test that no information is colour only.",
      "bg": { "$value": "#f5f5f5" },
      "surface": { "$value": "#ffffff" },
      "surface-2": { "$value": "#eeeeee" },
      "surface-3": { "$value": "#e2e2e2" },
      "border": { "$value": "#d9d9d9" },
      "border-strong": { "$value": "#666666" },
      "fg": { "$value": "#111111" },
      "muted": { "$value": "#666666" },
      "brand": { "$value": "#444444" },
      "brand-2": { "$value": "#555555" },
      "glow": { "$value": "#777777" },
      "accent": { "$value": "#777777" },
      "danger": { "$value": "#333333" },
      "ok": { "$value": "#555555" },
      "warn": { "$value": "#777777" },
      "on-brand": { "$value": "#ffffff" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Be Vietnam Pro", "Segoe UI", "Arial", "sans-serif"], "$description": "Inherited (apps/web/app/layout.tsx). Geometric sans, used throughout." },
      "display": { "$value": ["Space Grotesk", "Be Vietnam Pro", "sans-serif"], "$description": "Inherited, not chosen here: it is the product's existing heading face. New components set headings in sans at weight strong instead." }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "strong": { "$value": 600, "$description": "Two weights only in new work. The inherited font-medium (500) is not used by new components." }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "0.75rem", "$description": "12px. Floor for new text; the inherited 10px and 11px labels are not repeated." },
      "sm": { "$value": "0.875rem" },
      "base": { "$value": "1rem" },
      "lg": { "$value": "1.25rem" },
      "xl": { "$value": "1.5rem" }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.25 },
      "body": { "$value": 1.5 }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "6": { "$value": "1.5rem" },
    "8": { "$value": "2rem" },
    "12": { "$value": "3rem" },
    "touch": { "$value": "2.75rem", "$description": "44px minimum target" },
    "gutter": { "$value": "1.5rem", "$description": "12-column grid gap (wide gutter)" },
    "measure": { "$value": "44rem", "$description": "max line length of reading blocks" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "0.5rem", "$description": "controls, code, diff" },
    "md": { "$value": "1rem", "$description": "= rounded-2xl: fact cards, notices" },
    "lg": { "$value": "1.5rem", "$description": "= rounded-3xl: empty state, page cards" },
    "full": { "$value": "9999px", "$description": "chips, badges" }
  },
  "elevation": {
    "$type": "shadow",
    "soft": {
      "$value": { "color": "#0f172a29", "offsetX": "0px", "offsetY": "0.25rem", "blur": "1rem", "spread": "0px" },
      "$description": "NEW. The one elevation for new surfaces: the access-record drawer and menus. Cards stay flat with a border."
    },
    "ring-focus": { "$value": { "color": "#0d98ba59", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "0.1875rem" }, "$description": "Inherited. Dark: #7df9ff73." }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms", "$description": "NEW. Fades for label changes, expand, drawer, banner. Nothing new exceeds 150ms." },
      "instant": { "$value": "0ms", "$description": "prefers-reduced-motion" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] }
    }
  }
}
